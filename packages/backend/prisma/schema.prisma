// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChannelVisibility {
  PUBLIC
  PRIVATE
  DIRECT
}

enum ChannelRole {
  MEMBER
  ADMIN
}

enum WorkspaceRole {
  MEMBER
  MANAGER
  OWNER
}

enum userStatus {
  available
  appearOffline
  away
  busy
}

enum TenantWorkspaceVisibility {
  PUBLIC
  PRIVATE
}

model Tenant {
  id                         String      @id @default(uuid())
  keystoneId                 String      @unique
  users                      User[]
  workspaces                 Workspace[]
  userAllowWorkspaceCreation Boolean     @default(false)
  primaryWorkspaceId         String?
  keystoneObject             Json?
}

model User {
  id             String                @id @default(uuid())
  username       String?               @unique
  email          String                @unique
  keystoneId     String                @unique
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @default(now()) @updatedAt
  keystoneObject Json
  memberships    WorkspaceMembership[]
  tenantId       String?
  tenant         Tenant?               @relation(fields: [tenantId], references: [id])
}

model WorkspaceGroup {
  id          String                     @id @default(uuid())
  memberships WorkspaceGroupMembership[]
  name        String
  displayName String
  workspaceId String
  workspace   Workspace                  @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, name])
}

model WorkspaceGroupMembership {
  id                    String              @id @default(uuid())
  workspaceGroupId      String
  workspaceMembershipId String
  workspaceGroup        WorkspaceGroup      @relation(fields: [workspaceGroupId], references: [id])
  workspaceMembership   WorkspaceMembership @relation(fields: [workspaceMembershipId], references: [id])
}

model WorkspaceMembership {
  id               String                     @id @default(uuid())
  userId           String
  workspaceId      String
  name             String
  profilePicture   String?
  workspace        Workspace                  @relation(fields: [workspaceId], references: [id])
  user             User                       @relation(fields: [userId], references: [id])
  channels         ChannelMembership[]
  role             WorkspaceRole              @default(MEMBER)
  status           userStatus                 @default(available)
  lastStatusChange DateTime                   @default(now())
  lastSeen         DateTime                   @default(now())
  statusMessage    String?
  groups           WorkspaceGroupMembership[]
  messages         Message[]                  @relation("MessageSentBy")
}

model ChannelMembership {
  id         String              @id @default(uuid())
  channelId  String
  userId     String
  role       ChannelRole         @default(MEMBER)
  channel    Channel             @relation(fields: [channelId], references: [id])
  membership WorkspaceMembership @relation(fields: [userId], references: [id])
}

model ExternalChannelConnection {
  id          String    @id @default(uuid())
  channelId   String
  channel     Channel   @relation(fields: [channelId], references: [id])
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
}

model Workspace {
  id                  String                      @id @default(uuid())
  memberships         WorkspaceMembership[]
  name                String
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @default(now()) @updatedAt
  image               String?
  channels            Channel[]
  slug                String                      @unique
  groups              WorkspaceGroup[]
  tenantId            String?
  tenant              Tenant?                     @relation(fields: [tenantId], references: [id])
  tenantVisibility    TenantWorkspaceVisibility   @default(PUBLIC)
  externalConnections ExternalChannelConnection[]
}

model Channel {
  id                  String                      @id @default(uuid())
  name                String
  workspaceId         String
  workspace           Workspace                   @relation(fields: [workspaceId], references: [id])
  messages            Message[]
  visibility          ChannelVisibility
  members             ChannelMembership[]
  externalConnections ExternalChannelConnection[]
  subChannels         Channel[]                   @relation("SubChannel")
  parentChannel       Channel?                    @relation("SubChannel", fields: [parentChannelId], references: [id])
  parentChannelId     String?

  @@unique([workspaceId, name])
}

model Message {
  id          String              @id @default(uuid())
  inReplyTo   Message?            @relation("MessageReplies", fields: [inReplyToId], references: [id])
  inReplyToId String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @default(now()) @updatedAt
  content     Json
  channelId   String
  channel     Channel             @relation(fields: [channelId], references: [id])
  replies     Message[]           @relation("MessageReplies")
  reactions   Json?
  sentById    String
  sentBy      WorkspaceMembership @relation("MessageSentBy", fields: [sentById], references: [id])
}
